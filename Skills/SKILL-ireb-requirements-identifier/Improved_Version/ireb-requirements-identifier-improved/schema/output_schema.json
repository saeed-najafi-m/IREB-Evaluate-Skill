{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original Requirement List",
  "description": "List of original requirements identified in elicitation results.",
  "type": "object",
  "additionalProperties": false,

  "required": ["original_requirements"],

  "properties": {
    "original_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/originalRequirement"
      }
    }
  },

  "$defs": {

    "originalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "statements"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "statements": {
          "items": {
            "$ref": "#/$defs/originalStatement"
          },
          "type": "array"
        }
      }
    },

    "originalStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "source"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    }

  }
}
